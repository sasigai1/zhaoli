<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.adas.interviewprep"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ADASPrep" >
        <activity
            android:name="com.adas.interviewprep.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.adas.interviewprep.KnowledgeListActivity" />
        <activity android:name="com.adas.interviewprep.KnowledgeDetailActivity" />
        <activity android:name="com.adas.interviewprep.QuestionListActivity" />
        <activity android:name="com.adas.interviewprep.QuestionDetailActivity" />
        <activity android:name="com.adas.interviewprep.QuizActivity" />
        <activity android:name="com.adas.interviewprep.MockInterviewActivity" />
        <activity android:name="com.adas.interviewprep.GuideActivity" />
        <activity android:name="com.adas.interviewprep.StatsActivity" />
    </application>

</manifest>