<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- intro -->
    <LinearLayout
        android:id="@+id/mock_intro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 模拟面试"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="随机抽取 8 道题全真模拟：\nADAS功能×2 / 测试流程×1 / 工具技能×1\n总线技术×1 / 项目经验×2 / 综合HR×1\n\n规则：\n1. 看题后先大声说出你的回答（模拟真实场景）\n2. 查看参考答案，对比差距\n3. 按 1-5 分自评：1=完全不会，5=对答如流\n4. 自评≤2分的题自动进入待巩固清单"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.5"
            android:paddingTop="20dp"
            android:paddingBottom="32dp" />

        <Button
            android:id="@+id/btn_mock_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开始模拟面试" />
    </LinearLayout>

    <!-- running -->
    <LinearLayout
        android:id="@+id/mock_running"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/mock_progress"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <Chronometer
                android:id="@+id/mock_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/accent" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/mock_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/accent"
                    android:paddingBottom="10dp" />

                <TextView
                    android:id="@+id/mock_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.3"
                    android:paddingBottom="16dp" />

                <TextView
                    android:id="@+id/mock_answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.4"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/bg_card">

            <Button
                android:id="@+id/btn_mock_show"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="查看参考答案" />

            <LinearLayout
                android:id="@+id/mock_score_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="自评得分（1=不会 5=完美）"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:id="@+id/mock_score_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- result -->
    <LinearLayout
        android:id="@+id/mock_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 面试结果"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:paddingBottom="16dp" />

                <TextView
                    android:id="@+id/mock_result_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btn_mock_restart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="再面一次" />
    </LinearLayout>
</FrameLayout>
